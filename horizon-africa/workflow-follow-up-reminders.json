{
  "name": "Horizon Africa - Automated Follow-Up Reminders",
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily 9AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?select=id,phone_number,full_name,offered_package,follow_up_date,follow_up_sent&follow_up_requested=eq.true&follow_up_sent=eq.false&follow_up_date=lte.{{ $today.toISODate() }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_ANON_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "query-pending-followups",
      "name": "Query Pending Follow-Ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "notes": "Queries Supabase for leads where follow_up_requested=true, follow_up_sent=false, and follow_up_date is today or earlier."
    },
    {
      "parameters": {
        "jsCode": "// Split the array of leads into individual items for processing\nconst leads = $input.first().json;\n\nif (!leads || leads.length === 0) {\n  return [];\n}\n\nreturn leads.map(lead => ({\n  json: {\n    leadId: lead.id,\n    phoneNumber: lead.phone_number,\n    fullName: lead.full_name || 'there',\n    offeredPackage: lead.offered_package || 'fibre',\n    followUpDate: lead.follow_up_date\n  }\n}));"
      },
      "id": "split-leads",
      "name": "Split Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/{{ $env.META_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.META_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.phoneNumber }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"horizon_followup_v1\",\n    \"language\": {\n      \"code\": \"en\"\n    },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"{{ $json.fullName }}\"\n          },\n          {\n            \"type\": \"text\",\n            \"text\": \"{{ $json.offeredPackage }}\"\n          }\n        ]\n      }\n    ]\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-reminder",
      "name": "Send WhatsApp Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "notes": "Sends the follow_up_reminder template message via Meta WhatsApp Business API. Template name: horizon_followup_v1 (needs Meta approval)."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?id=eq.{{ $json.leadId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"follow_up_sent\": true,\n  \"follow_up_sent_at\": \"{{ new Date().toISOString() }}\",\n  \"updated_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "update-lead-sent",
      "name": "Mark Lead as Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0],
      "notes": "Updates the lead record in Supabase to mark the follow-up as sent with timestamp."
    },
    {
      "parameters": {
        "jsCode": "// Log summary of the follow-up run\nconst items = $input.all();\nconst sentCount = items.length;\nconst now = new Date().toISOString();\n\nconsole.log(`Follow-up reminders sent: ${sentCount} at ${now}`);\n\nreturn {\n  json: {\n    sentCount,\n    timestamp: now,\n    status: 'completed'\n  }\n};"
      },
      "id": "log-summary",
      "name": "Log Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    }
  ],
  "connections": {
    "Daily 9AM Trigger": {
      "main": [
        [
          {
            "node": "Query Pending Follow-Ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Pending Follow-Ups": {
      "main": [
        [
          {
            "node": "Split Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Leads": {
      "main": [
        [
          {
            "node": "Send WhatsApp Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp Reminder": {
      "main": [
        [
          {
            "node": "Mark Lead as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Lead as Sent": {
      "main": [
        [
          {
            "node": "Log Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
